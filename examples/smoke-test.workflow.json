    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.serverUrl }}/graph/v1.0/drives",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openCloudApi",
        "sendBody": true,
