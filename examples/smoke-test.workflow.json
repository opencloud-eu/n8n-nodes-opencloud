      "id": "resolve-space",
      "name": "Resolve space (list drives)",
      "notesInFlow": true,
      "notes": "Calls /graph/v1.0/me/drives via the OpenCloud node so we can pick the personal drive without hardcoding any drive id. Works against any backend.",
      "credentials": {
        "openCloudApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Pick the personal drive from the Space:List output, then expose the\n// fixed test inputs (root folder + test file name). All downstream nodes\n// reference these via $(\"Config\").first().json.\nconst inputs = $input.all().map((it) => it.json);\n// If the upstream Space:List had continueOnFail enabled and the call to\n// OpenCloud failed, n8n substitutes { error, errorDescription } for the\n// drive list. Surface that root cause instead of stringifying nulls.\nconst upstream = inputs.find((i) => i && typeof i.error === \"string\");\nif (upstream) {\n\tconst detail = upstream.errorDescription ? upstream.error + \" \\u2014 \" + upstream.errorDescription : upstream.error;\n\tthrow new Error(\"Cannot resolve a personal drive: the upstream Resolve-space step failed: \" + detail);\n}\nconst personal = inputs.find((d) => d && d.driveType === \"personal\");\nif (!personal) {\n\tconst summary = inputs.length === 0 ? \"(no drives returned)\" : inputs.map((d) => (d && d.name ? d.name : \"<no-name>\") + \"/\" + (d && d.driveType ? d.driveType : \"<no-type>\")).join(\", \");\n\tthrow new Error(\"No personal drive in /me/drives response. Drives received: \" + summary + \". Verify the credential authenticates as a user that has a personal drive provisioned.\");\n}\nconst _base = personal.webUrl || (personal.root && personal.root.webDavUrl) || \"\";\nconst _m = _base.match(/^https?:\\/\\/[^/]+/);\nconst serverUrl = _m ? _m[0] : \"\";\nreturn [{ json: { spaceId: personal.id, rootFolder: \"/n8n-smoke\", fileName: \"hello.txt\", serverUrl } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
